# ============================================
# CONFIGURACIÓN DE API KEYS
# ============================================

# API Key de Google Gemini (para análisis de imágenes)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=tu_google_api_key_aqui

# API Key de HuggingFace (para generación de imágenes)
# Obtén tu API key en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=tu_huggingface_api_key_aqui

# ============================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ============================================

# 1. Copia este archivo y renómbralo a ".env" (sin el .example)
# 2. Reemplaza los valores de ejemplo con tus API keys reales
# 3. NO compartas este archivo ni lo subas a repositorios públicos
# 4. Asegúrate de que .env esté en tu .gitignore

# ============================================
# CONFIGURACIÓN EN STREAMLIT CLOUD
# ============================================

# Si vas a desplegar en Streamlit Cloud:
# 1. Ve a tu app en https://share.streamlit.io/
# 2. Click en "Settings" > "Secrets"
# 3. Agrega las siguientes líneas:
#
# GOOGLE_API_KEY = "tu_google_api_key_aqui"
# HUGGINGFACE_API_KEY = "tu_huggingface_api_key_aqui"
#
# 4. Guarda los cambios y reinicia la app

# ============================================
# NOTAS IMPORTANTES
# ============================================

# - Las API keys son GRATUITAS para uso personal/educativo
# - HuggingFace tiene límites de rate (requests por minuto)
# - Gemini tiene cuota gratuita generosa para análisis
# - Mantén tus keys seguras y no las compartas públicamente
